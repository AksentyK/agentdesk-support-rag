# Copy to .env.local for Next.js (never commit real secrets)
NODE_ENV=development
DATABASE_URL=postgresql://agentdesk:agentdesk_local_only@localhost:5432/agentdesk_rag
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_API_KEY=
# Exact model IDs from your RouterAI account/catalog; not arbitrary labels
BASELINE_MODEL_ID=
STRONG_MODEL_ID=
# RouterAI embeddings provider
EMBEDDING_PROVIDER=routerai
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=4096
RAG_TOP_K=5
RAG_CHUNK_TOKENS=800
RAG_CHUNK_OVERLAP=120
MODEL_TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=800
REQUEST_TIMEOUT_MS=60000
# Lock public demo behind password, and store safely
DEMO_ACCESS_PASSWORD=
MAX_PARALLEL_EVAL_REQUESTS=2
# Unknown prices => UI must show 'not calculated', NOT 0
BASELINE_INPUT_PRICE_PER_1M=
BASELINE_OUTPUT_PRICE_PER_1M=
STRONG_INPUT_PRICE_PER_1M=
STRONG_OUTPUT_PRICE_PER_1M=
PRICING_CURRENCY=RUB
# Suggested model pair (verify availability in RouterAI before use):
# BASELINE_MODEL_ID=deepseek/deepseek-v4-flash
# STRONG_MODEL_ID=anthropic/claude-sonnet-5.5
# Set provider secrets in the Vercel project environment; never commit .env.local.
# RouterAI neural embeddings; vector dimension is verified as 4096.
# The configured model/dimension must match every active indexed vector.
RAG_MIN_SCORE=0.18
RAG_SEMANTIC_WEIGHT=0.65
PRICING_DATE=
# For docker compose only; set securely in your shell, not in Git.
POSTGRES_PASSWORD=
# Optional canonical public origin for CSRF validation, e.g. https://your-preview.vercel.app
APP_ORIGIN=

# Vercel + Neon: pooled DATABASE_URL for the app; direct endpoint for migrations.
# Both must point to the SAME Neon database/branch with TLS (sslmode=require).
DIRECT_URL=
# Vercel uses Workflow; local development can use the worker.
EVALUATION_EXECUTOR=
